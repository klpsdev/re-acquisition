# sample = built-in demo data, no keys needed. live = use every connector below that has credentials.
DATA_MODE=sample
DATABASE_URL=sqlite:///./sprev.db
CORS_ORIGINS=http://localhost:3000
# Shared secret with the web app (same value as API_TOKEN there). Leave empty for local dev.
API_TOKEN=

# Neighborhood stats (US Census ACS). Free key, required: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
CENSUS_ACS_YEAR=2023

# Property record, rent estimate, value comps: https://app.rentcast.io/app/api
RENTCAST_API_KEY=

# MLS closed sales via RESO Web API. Needs a data license from the MLS.
# Bright MLS test endpoint (switch to https://bright-reso.brightmls.com/RESO/OData/bright once approved):
RESO_BASE_URL=https://bright-reso.tst.brightmls.com/RESO/OData/bright
# Bright uses OAuth 2 client credentials; the token URL comes with your Bright onboarding.
RESO_TOKEN_URL=
RESO_CLIENT_ID=
RESO_CLIENT_SECRET=
RESO_SCOPE=
RESO_TOKEN_AUTH=body
# Or, for vendors that issue a static bearer token (e.g. Bridge):
RESO_ACCESS_TOKEN=

# Optional: Claude writes the explanation / polishes letters. Numbers are always computed in Python.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Email offers from your Gmail (see README "Sending offers from Gmail").
# Get the refresh token once with: python backend/scripts/gmail_auth.py --client-id ... --client-secret ...
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
EMAIL_SENDER_NAME=
# Optional: CC these addresses on every offer (comma separated)
EMAIL_CC=

BUYER_ENTITY=SP Real Estate Ventures, LLC
